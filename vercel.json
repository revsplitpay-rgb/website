{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/signup", "destination": "https://app.revsplitpay.com/", "permanent": true },
    { "source": "/early-access", "destination": "/", "permanent": true },
    { "source": "/pricing/starter", "destination": "/pricing", "permanent": true },
    { "source": "/pricing/professional", "destination": "/pricing", "permanent": true },
    { "source": "/legal/terms-&-condition", "destination": "/legal/terms", "permanent": true },
    { "source": "/legal/privacy-policy", "destination": "/legal/privacy", "permanent": true },
    { "source": "/legal/cookie-policy", "destination": "/legal/cookies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/v2/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/v2",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
